local endpointLabel = label("Web "..CREATORMAKE_APP_VERSION.." · Bridge "..EXPECTED_BRIDGE_VERSION.." · Protocol "..tostring(SUPPORTED_PROTOCOL_VERSION).." · Port 32145", 28, Color3.fromRGB(154,160,180))
